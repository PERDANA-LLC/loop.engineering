# loop.env: the settings for run.sh. Each line keeps a value you set in the environment,
# so `MAX_ITERS=2 ./run.sh --real` overrides the default for one run.
# Layer: Loop. A person changes these, never the loop; note every change in LOOP-SPEC.md's changelog.

# Models (Claude Code aliases, resolved by your installed version; ⚠VERIFY with `claude --help`).
# The judge runs on a different model from the maker (BP-2.1: separate maker and checker).
: "${MAKER_MODEL:=opus}"
: "${JUDGE_MODEL:=sonnet}"
: "${MAKER_EFFORT:=high}"

# CAP: iterations per unit, from CALC-2 (p = 0.6, C = 0.95 -> 4). See LOOP-SPEC.md.
: "${MAX_ITERS:=4}"
# CAP: wall-clock minutes per unit run (checked before each iteration).
: "${MAX_MINUTES:=180}"
# CAP: dollars per single Claude call (claude -p --max-budget-usd), and minutes before a call is stopped.
# v2.0's units are about half again as long as v1.0's (CALC-3 in LOOP-SPEC.md).
: "${MAKER_BUDGET_USD:=12.00}"
: "${JUDGE_BUDGET_USD:=1.50}"
: "${MAKER_TIMEOUT_MIN:=45}"
: "${JUDGE_TIMEOUT_MIN:=15}"

# STUCK: the same checker result this many times in a row (CS-2: the same mismatch twice).
: "${STUCK_LIMIT:=2}"

# HUMAN: stop before starting a new unit while this many drafts wait for your doctrine review.
: "${MAX_UNREVIEWED:=3}"
# HUMAN: KJV82's Blueprint checkpoint. 1 = chapter units wait until a person approves unit 00, the overview,
# whose Lesson Map sets each lesson's title, Big Idea, and memory verse. `./run.sh --real --unit NN` runs one anyway.
: "${BLUEPRINT_CHECKPOINT:=1}"
: "${STOP_FILE:=.loop-stop}"

# STATE: commit after each iteration and at the end of a run (real mode, on a branch that isn't main).
: "${COMMIT:=1}"

# The Claude Code command.
: "${CLAUDE_BIN:=claude}"
